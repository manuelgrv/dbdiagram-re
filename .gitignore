# Installed dependencies and generated builds/release archives
node_modules/
/dist/
/artifacts/

# Test reports, caches, and temporary output
/coverage/
/.cache/
/.vite/
/tmp/
/temp/
*.tsbuildinfo
*.log

# Local secrets/configuration; keep shareable example templates
.env
.env.*
!.env.example
!.env.*.example

# Operating-system and editor working files
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~

# Explicit opt-in portable build for retrieval through git clone/pull.
# Keep everything else in downloads excluded unless deliberately allowed here.
/downloads/*
!/downloads/README.md
!/downloads/SHA256SUMS.txt
!/downloads/DBML-Studio-windows-x64.zip
